# Copiar a .env y completar. Nunca subir .env al repo.

# Claude
ANTHROPIC_API_KEY=

# PostgreSQL (los usa el contenedor db)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Conexión del backend a la base de datos (host = nombre del servicio en docker-compose)
DB_URL=postgresql://<usuario>:<contraseña>@db:5432/<base_de_datos>
