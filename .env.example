# =====================================================================
# Variables de entorno de PQRSD Coffee Devs
# Copiar a .env y completar:   cp .env.example .env
# NUNCA subir .env al repositorio (ya está en .gitignore).
# Aquí solo van marcadores ("cambiar-esto"), jamás valores reales.
# =====================================================================

# ---------------------------------------------------------------------
# Claude (Anthropic)
# ---------------------------------------------------------------------
# OBLIGATORIA. Si falta o está vacía, el backend no arranca.
ANTHROPIC_API_KEY=cambiar-esto

# Opcionales. Modelo liviano para chat y clasificación; modelo más capaz
# solo para el borrador final de respuesta.
# Verificar en la documentación de Anthropic antes de usar.
MODELO_LIGERO=claude-haiku-5-5
MODELO_BORRADOR=claude-sonnet-5-5

# ---------------------------------------------------------------------
# PostgreSQL (los usa el contenedor db para crear la base)
# ---------------------------------------------------------------------
POSTGRES_USER=pqrsd
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=pqrsd

# OBLIGATORIA. Conexión del backend a la base con el driver psycopg v3.
# El host es "db" (nombre del servicio en docker-compose). Usuario,
# contraseña y base deben coincidir con las tres variables de arriba.
DB_URL=postgresql+psycopg://pqrsd:cambiar-esto@db:5432/pqrsd

# ---------------------------------------------------------------------
# Opcionales del backend
# ---------------------------------------------------------------------
# Dimensión de los embeddings de fragmentos_conocimiento (por defecto 384).
# Si se cambia con la base ya creada hay que recrear la tabla
# (docker compose down -v borra todo el volumen de datos).
EMBEDDING_DIM=384

# Entorno de ejecución: desarrollo | evento
APP_ENV=desarrollo

# ---------------------------------------------------------------------
# Embeddings y RAG (opcionales)
# ---------------------------------------------------------------------
# Modelo local de embeddings (fastembed). Debe dar EMBEDDING_DIM dimensiones.
# Si se cambia, recargar el conocimiento con --forzar.
EMBEDDING_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Carpeta donde se descarga el modelo (en Docker es el volumen "modelos").
EMBEDDING_CACHE_DIR=/modelos
# Cargar los modelos SVM y de embeddings al arrancar (en segundo plano).
PRECARGAR_MODELOS=true
# Fragmentos que se recuperan por consulta y similitud mínima (0 a 1).
RAG_TOP_K=4
RAG_UMBRAL_SIMILITUD=0.30

# ---------------------------------------------------------------------
# Control de costos de IA (opcionales)
# ---------------------------------------------------------------------
MAX_MENSAJES_SESION=12
GASTO_ALERTA_USD=30
GASTO_TOPE_USD=40
# USD por millón de tokens. Deben corresponder a MODELO_LIGERO y MODELO_BORRADOR.
# Verificar en la página de precios de Anthropic antes de usar.
PRECIO_LIGERO_ENTRADA_USD_MTOK=0.10
PRECIO_LIGERO_SALIDA_USD_MTOK=0.50
PRECIO_BORRADOR_ENTRADA_USD_MTOK=2.00
PRECIO_BORRADOR_SALIDA_USD_MTOK=10.00

# ---------------------------------------------------------------------
# Plazos y semáforo (opcionales)
# ---------------------------------------------------------------------
# Plazo general de respuesta en días hábiles (sin sábados, domingos ni festivos de Colombia).
PLAZO_DIAS_HABILES=15
# Plazo distinto por tipo, en JSON. Verificar los términos en la Ley 1755 de 2015 antes de cambiarlos.
# PLAZOS_POR_TIPO={"peticion": 15, "queja": 15, "reclamo": 15, "sugerencia": 15, "denuncia": 15}
# Semáforo: rojo si quedan estos días hábiles o menos (o ya venció); amarillo hasta estos días.
SEMAFORO_ROJO_DIAS=3
SEMAFORO_AMARILLO_DIAS=7

# ---------------------------------------------------------------------
# Panel administrativo
# ---------------------------------------------------------------------
# Usuario y clave del panel (/admin). Con el marcador "cambiar-esto":
# - APP_ENV=desarrollo usa las credenciales de demostración (ver README).
# - Cualquier otro APP_ENV deja el panel cerrado hasta definir una clave propia.
# En el servidor del evento: APP_ENV=evento y una clave que no esté en el repositorio.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiar-esto
ADMIN_SESION_HORAS=12
